{
  "name": "smartrouter-pro-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:check": "tsx scripts/startup-check.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:repos": "npx vitest run --config vitest.repo.config.ts tests/repositories/execution-result-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/repositories/task-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/repositories/memory-entry-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/repositories/growth-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/repositories/decision-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/repositories/behavioral-memory-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/repositories/identity-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/repositories/feedback-event-repo.test.ts && npx vitest run --config vitest.repo.config.ts tests/features/feedback-collector.test.ts",
    "test:repos:watch": "vitest --config vitest.repo.config.ts",
    "test:api": "npx vitest run --config vitest.api.config.ts",
    "test:api:watch": "vitest --config vitest.api.config.ts",
    "test:r1": "npx vitest run --config vitest.r1.config.ts",
    "test:r1:watch": "vitest --config vitest.r1.config.ts",
    "benchmark": "npx tsx ../evaluation/runner.ts",
    "benchmark:routing": "npx tsx ../evaluation/runner.ts --suite routing",
    "benchmark:quality": "npx tsx ../evaluation/runner.ts --suite quality",
    "benchmark:all": "npx tsx ../evaluation/runner.ts --suite all",
    "benchmark:report": "npx tsx ../evaluation/runner.ts --suite all --report",
    "benchmark:ci": "node scripts/benchmark-ci.cjs",
    "benchmark:ci:verbose": "node scripts/benchmark-ci.cjs --verbose",
    "trst1:gateway": "npx tsx --env-file=.env scripts/trst1/start-gateway.ts",
    "verify:trust": "npm run verify:chain && npm run verify:assess && npm run verify:bundle && npm run verify:index && npm run verify:egress && npm run verify:egress-fp",
    "verify:chain": "npx tsx scripts/verify-event-chain.mts",
    "verify:assess": "npx tsx scripts/verify-assessment-signals.mts",
    "verify:bundle": "npx tsx scripts/verify-evidence-bundle.mts",
    "verify:index": "npx tsx scripts/verify-jsonl-index.mts",
    "verify:egress": "npx tsx scripts/verify-egress-processing.mts",
    "verify:egress-fp": "npx tsx scripts/verify-egress-false-positive.mts",
    "verify:distill": "npx tsx scripts/verify-memory-distiller.mts",
    "verify:trust": "npm run verify:chain && npm run verify:assess && npm run verify:bundle && npm run verify:index && npm run verify:egress && npm run verify:egress-fp && npm run verify:distill",
    "trst1:report": "npx tsx scripts/trst1/generate-shadow-report.ts",
    "trst1:tool": "npx tsx scripts/trst1/simulate-tool-call.ts",
    "trst1:mcp:fake-server": "npx tsx scripts/trst1/fake-mcp-server.ts",
    "trst1:mcp:smoke": "node scripts/trst1/run-mcp-smoke.mjs",
    "trst2:stream-smoke": "node scripts/trst1/run-stream-smoke.mjs",
    "trst2:mcp-lifecycle-smoke": "node scripts/trst1/run-mcp-lifecycle-smoke.mjs",
    "trst2:health-metrics:smoke": "node scripts/trst2/run-health-metrics-smoke.mjs",
    "trst3:smoke": "node scripts/trst3/run-private-beta-smoke.mjs",
    "trst3:trace-demo": "node scripts/trst3/run-multi-event-trace-demo.mjs",
    "trst4:report-smoke": "npx tsx scripts/trst4/run-evidence-report-smoke.ts",
    "trst4b:streaming-smoke": "npx tsx scripts/trst4b/run-streaming-smoke.ts",
    "trst4c:smoke": "node scripts/trst4c/run-smoke.mjs",
    "validate": "npx tsx scripts/trst/run-validation.mts",
    "beta:check": "npx tsx scripts/trst/run-private-beta-check.mts",
    "beta:report": "npx tsx scripts/trst/run-private-beta-report.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@hono/node-server": "^1.11.0",
    "better-sqlite3": "^13.0.3",
    "eventsource-parser": "^1.1.0",
    "hono": "^4.4.0",
    "jose": "^6.2.2",
    "openai": "^4.52.0",
    "pg": "^8.12.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.0",
    "tiktoken": "^1.0.15",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "playwright": "^1.62.1",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
