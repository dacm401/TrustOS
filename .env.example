# ── Auth (REQUIRED in production) ──────────────────────────────────────────
JWT_SECRET=<your-strong-secret-min-32-chars>
AUTH_USERS=admin:changeme
JWT_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartrouter
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_CONN_TIMEOUT=5000

# ── Redis Cache (Optimization - NEW) ─────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Model Providers ────────────────────────────────────────────────────────
OPENAI_API_KEY=<your-key>
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
FAST_MODEL=Qwen/Qwen2.5-72B-Instruct
SLOW_MODEL=Qwen/Qwen2.5-72B-Instruct
COMPRESSOR_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── TrustOS Gateway ──────────────────────────────────────────────────────
# Gateway collects model_call events for evidence. When unavailable,
# Manager/Worker fall back to direct provider (graceful degradation).
# See AD-8: Trust Layer Graceful Degradation.
TRUSTOS_GATEWAY_URL=http://localhost:8787
TRUSTOS_UPSTREAM_BASE_URL=https://api.siliconflow.cn/v1
TRUSTOS_UPSTREAM_API_KEY=<your-key>

# ── Frontend Gateway URL (Next.js public env) ────────────────────────────
# Used by the frontend to poll Gateway health and display Trust Layer status.
# Defaults to http://localhost:8787 if unset.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787

# ── Admin ────────────────────────────────────────────────────────────────
# Local diagnostic admin view only. Not production RBAC. Not tenant administration.
TRUSTOS_ADMIN_KEY=admin-changeme

# ── Prompt ───────────────────────────────────────────────────────────────
MANAGER_PROMPT_VERSION=v4

# ── Metrics (Optimization - NEW) ─────────────────────────────────────────
METRICS_ENABLED=true

# ── Startup ────────────────────────────────────────────────────────────────
# Run this BEFORE `npm run dev` to check prerequisites:
#   npm run dev:check
#
# Expected output (all green = ready):
#   ✅ Database  connected (Xms)
#   ✅ Redis    connected
#   ✅ Port 3001 available
#   ✅ Port 3000 available
#   Auth: N user(s) configured (or ⚠ dev fallback)
