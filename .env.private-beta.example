# =============================================================================
# Private Beta Environment Template — MWT-9
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill ONLY what you need. This file contains EMPTY
# KEYS ONLY — no real secrets are committed. `.env` is gitignored.
#
# Requirement legend per capability:
#   [DET]  Deterministic validation  (npm run validate, offline)  -> not needed
#   [BRW]  Browser harness smoke      (real Chrome click path)     -> not needed
#   [LIV]  TRST-4H-III live tests     (Manager route-message)      -> REQUIRED
# =============================================================================

# --- Database (Postgres) -----------------------------------------------------
# [LIV] REQUIRED for TRST-4H-III live sections.
# manager-route.ts calls AgentSessionRepo.list(userId) before the clarification
# short-circuit, so the live path needs a reachable Postgres.
# Example: postgresql://user:pass@localhost:5432/trustos
DATABASE_URL=

# --- Model gateway -----------------------------------------------------------
# [LIV] REQUIRED for TRST-4H-III live sections (getAvailableModels() probes it).
# Provide EITHER the OpenAI-style pair OR the gateway alias pair.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Gateway alias pair (accepted alternative to OPENAI_* above)
GATEWAY_ENDPOINT=
GATEWAY_API_KEY=

# --- Frontend ----------------------------------------------------------------
# [BRW] Optional. Port the frontend dev server / browser harness uses.
# Default in harness is 3100.
FRONTEND_PORT=3100

# =============================================================================
# NOTES
# - Deterministic validation + browser smoke need NO env vars.
# - TRST-4H-III live tests need DATABASE_URL + a gateway pair.
# - Missing required [LIV] vars => ENV_BLOCKED (honest, not FAIL).
# - Never commit real secrets. This template is safe to commit (empty keys).
# =============================================================================
